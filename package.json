{
  "name": "bugify",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "forge:build": "forge build --root contracts",
    "forge:test": "forge test --root contracts",
    "forge:fmt": "forge fmt --root contracts",
    "verify:services": "bun run scripts/verify-services.ts",
    "verify:schema": "bun run scripts/verify-schema.ts",
    "demo": "scripts/demo.sh",
    "demo:stop": "scripts/demo.sh stop",
    "demo:reset": "scripts/demo.sh reset"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "dotenv": "^17.2.1",
    "viem": "2.56.0"
  }
}
