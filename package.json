{
  "name": "bugify",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "pnpm --filter web test",
    "forge:build": "forge build --root contracts",
    "forge:test": "forge test --root contracts",
    "forge:fmt": "forge fmt --root contracts",
    "verify:services": "bun run scripts/verify-services.ts",
    "verify:schema": "bun run scripts/verify-schema.ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "dotenv": "^17.2.1",
    "viem": "2.56.0"
  }
}
