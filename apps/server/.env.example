PORT=8787
RPC_URL=https://sepolia.base.org
# Defaults to the Base Sepolia deployment in contracts/deployments/84532.json
BAZAAR_ADDRESS=
# Hex private key of the verifier wallet (must match SingleVerifier.verifier())
VERIFIER_KEY=0x
ANTHROPIC_API_KEY=
# Optional: alternate API base (proxy). Passed straight to the Anthropic SDK client.
ANTHROPIC_BASE_URL=
TARGET_MODEL=claude-haiku-4-5-20251001
SUPABASE_URL=
SUPABASE_SECRET_KEY=
DISPUTE_WINDOW=60
REVEAL_TIMEOUT=120
K=3
INDEXER_INTERVAL_MS=4000
SETTLER_INTERVAL_MS=20000
# Optional: first block to scan when meta.lastIndexedBlock is empty (default: Bazaar deploy block)
INDEXER_START_BLOCK=

# Demo only: serve GET /commits/:cid/finding (transcript + traces) to anyone, no buyer signature. Never enable in production.
DEMO_PUBLIC_FINDINGS=false
