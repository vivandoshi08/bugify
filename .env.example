# Copy to apps/web/.env.local and contracts/.env. Never commit real values.

# Privy (authentication provider)
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Base Sepolia (chain ID 84532)
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployer (contracts only). PRIVATE_KEY never goes in apps/web.
DEPLOYER_ADDRESS=
PRIVATE_KEY=

# Supabase (database only; auth handled by Privy)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Basescan (contract verification)
BASESCAN_API_KEY=
